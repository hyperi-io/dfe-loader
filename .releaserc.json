{
  "branches": [
    {
      "name": "main",
      "prerelease": "dev"
    },
    "release"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "hotfix",
            "release": "patch"
          },
          {
            "type": "security",
            "release": "patch"
          },
          {
            "type": "sec",
            "release": "patch"
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "refactor",
            "release": false
          },
          {
            "type": "style",
            "release": false
          },
          {
            "type": "build",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "deps",
            "release": false
          },
          {
            "type": "revert",
            "release": false
          },
          {
            "type": "wip",
            "release": false
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo ${nextRelease.version} > VERSION && python3 -c \"import re, pathlib; f=pathlib.Path('Cargo.toml'); f.write_text(re.sub(r'^(version\\s*=\\s*)\\\"[^\\\"]+\\\"', r'\\g<1>\\\"${nextRelease.version}\\\"', f.read_text(), count=1, flags=re.MULTILINE))\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "VERSION",
          "Cargo.toml"
        ],
        "message": "chore: version ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
