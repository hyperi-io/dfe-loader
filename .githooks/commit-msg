#!/usr/bin/env bash
# Conventional commit validation hook
# Install: git config core.hooksPath .githooks

set -euo pipefail

if command -v hyperi-ci >/dev/null 2>&1 && hyperi-ci check-commit --help >/dev/null 2>&1; then
    hyperi-ci check-commit "$1"
elif command -v uvx >/dev/null 2>&1 && uvx hyperi-ci check-commit --help >/dev/null 2>&1; then
    uvx hyperi-ci check-commit "$1"
else
    echo "Warning: hyperi-ci check-commit not available — skipping commit validation" >&2
    exit 0
fi
