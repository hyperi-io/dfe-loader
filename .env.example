# Environment variables for dfe-loader
# Copy to .env and fill in real values
# Always quote ENV values - no exceptions

# =============================================================================
# ClickHouse Configuration
# =============================================================================
# Native port: 9000 (no TLS) or 9440 (TLS)
# HTTP port: 8123 (no TLS) or 8443 (TLS)
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_NATIVE_PORT="9000"
CLICKHOUSE_HTTP_PORT="8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="default"

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BROKERS="localhost:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_PLAINTEXT"
KAFKA_SASL_USER="loader"
KAFKA_SASL_PASSWORD=""

# =============================================================================
# Optional: MaxMind GeoIP (for enrichment feature)
# =============================================================================
# MAXMIND_ACCOUNT_ID=""
# MAXMIND_LICENSE_KEY=""

# =============================================================================
# K8s Integration Test Environment (example)
# =============================================================================
# Uncomment and modify for your test environment
#
# CLICKHOUSE_HOST="k8s.example.com"
# CLICKHOUSE_NATIVE_PORT="30900"
# CLICKHOUSE_HTTP_PORT="30123"
# CLICKHOUSE_USER="default"
# CLICKHOUSE_PASSWORD="your-password"
# CLICKHOUSE_DATABASE="benchmark"
#
# KAFKA_BROKERS="k8s.example.com:30092"
# KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
# KAFKA_SECURITY_PROTOCOL="SASL_PLAINTEXT"
# KAFKA_SASL_USER="loader"
# KAFKA_SASL_PASSWORD="your-password"
