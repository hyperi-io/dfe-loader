# =============================================================================
# dfe-loader Environment (example)
# =============================================================================
# Copy to .env and fill in real values. Always quote values.
#
# This file configures BOTH the loader runtime AND integration/e2e tests.

# =============================================================================
# Tests
# =============================================================================
# The tests start one ClickHouse and one Kafka container per run. A local core
# run can use pet servers instead through the HYPERI_TEST_* settings, set here
# or in the file HYPERI_TEST_ENV_FILE names. tests/TESTING.md lists them.
# HYPERI_TEST_ENV_FILE=""
#
# TEST_MODE="docker" points the ClickHouse tests and tests/e2e at a dfe-docker
# stack on localhost instead.
TEST_MODE="remote"

# =============================================================================
# ClickHouse Configuration
# =============================================================================
# Read by benches/insert_bakeoff.rs.
# Native port: 9000 (no TLS) or 9440 (TLS)
# HTTP port: 8123 (no TLS) or 8543 (TLS)
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_NATIVE_PORT="9000"
CLICKHOUSE_HTTP_PORT="8123"
CLICKHOUSE_TLS="false"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="default"
CLICKHOUSE_CLUSTER="default"

# =============================================================================
# Kafka Configuration
# =============================================================================
# Read by tests/e2e.
KAFKA_BROKERS="localhost:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_PLAINTEXT"
KAFKA_SASL_USER="loader"
KAFKA_SASL_PASSWORD=""

# =============================================================================
# Optional: MaxMind GeoIP (for enrichment feature)
# =============================================================================
# MAXMIND_ACCOUNT_ID=""
# MAXMIND_LICENSE_KEY=""

# =============================================================================
# Kafbat UI
# =============================================================================
# KAFBAT_UI_URL="http://localhost:8080"
